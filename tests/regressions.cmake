# Real native fuzzing processes. No Python and no simulation of runtime events.
file(MAKE_DIRECTORY "${WORK}")
function(run_case name mode expected required)
  set(dir "${WORK}/${name}")
  file(MAKE_DIRECTORY "${dir}/corpus" "${dir}/artifacts")
  file(WRITE "${dir}/corpus/seed" "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  string(TIMESTAMP start "%s")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "TKUR_FIXTURE=${mode}"
    "${FIXTURE}" -seed=1 -reload=0 -shuffle=0 -reduce_inputs=1 -detect_leaks=0
    "-artifact_prefix=${dir}/artifacts/" ${ARGN} "${dir}/corpus"
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 12)
  string(TIMESTAMP end "%s")
  math(EXPR elapsed "${end}-${start}")
  set(log "${out}${err}")
  file(WRITE "${dir}/output.log" "${log}")
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${name}: expected ${expected}, got ${result}: ${log}")
  endif()
  if(NOT "${required}" STREQUAL "" AND NOT log MATCHES "${required}")
    message(FATAL_ERROR "${name}: missing ${required}: ${log}")
  endif()
  message(STATUS "PASS ${name}: exit=${result}, elapsed=${elapsed}s")
  set(LAST_LOG "${log}" PARENT_SCOPE)
  set(LAST_DIR "${dir}" PARENT_SCOPE)
  set(LAST_ELAPSED "${elapsed}" PARENT_SCOPE)
endfunction()
run_case(new_space flat 0 "stopping after new-stall" --new-stall 1)
run_case(new_equals flat 0 "stopping after new-stall" --new-stall=1)
run_case(cov_space flat 0 "stopping after cov-stall" --cov-stall 1)
run_case(cov_equals flat 0 "stopping after cov-stall" --cov-stall=1)
run_case(both flat 0 "stopping after cov-stall" --new-stall 5 --cov-stall=1)
run_case(last_alias flat 0 "stopping after new-stall" -new_stall=5 --new-stall=1)
run_case(last_raw flat 0 "stopping after new-stall" --new-stall=5 -new_stall=1)
run_case(last_zero flat 0 "DONE" --new-stall 1 -new_stall=0 --cov-stall 0 -runs=13)
if(LAST_LOG MATCHES "TKUR: stopping")
  message(FATAL_ERROR "zero must disable timer")
endif()
run_case(disabled flat 0 "DONE" --new-stall=0 --cov-stall=0 -runs=13)
run_case(unknown flat 0 "unrecognized flag" --not-a-tkur-flag=17 -not_a_flag=17 -runs=2)
run_case(reduce reduce 0 "stopping after new-stall" --new-stall=1 -mutate_depth=1)
if(NOT LAST_LOG MATCHES "REDUCE" OR LAST_LOG MATCHES "#[0-9]+[ \t]+NEW")
  message(FATAL_ERROR "Expected actual REDUCE without NEW: ${LAST_LOG}")
endif()
run_case(features features 0 "stopping after cov-stall" --new-stall=1 --cov-stall=1 -use_value_profile=1)
string(REGEX MATCHALL "#[0-9]+[ \t]+NEW[^\n]*" new_lines "${LAST_LOG}")
list(LENGTH new_lines new_count)
if(new_count LESS 3)
  message(FATAL_ERROR "Expected multiple feature-only NEW events: ${LAST_LOG}")
endif()
foreach(line IN LISTS new_lines)
  if(NOT line MATCHES "cov: 1 ")
    message(FATAL_ERROR "Feature-only corpus unexpectedly changed PC cov: ${line}")
  endif()
endforeach()
run_case(pc_growth pc 0 "cov: 2" --cov-stall=1)
if(NOT LAST_LOG MATCHES "stopping after cov-stall")
  message(FATAL_ERROR "PC growth must eventually stall")
endif()
run_case(initial_corpus slow-init 0 "stopping after new-stall" --new-stall=1)
if(LAST_ELAPSED LESS 2)
  message(FATAL_ERROR "Initial corpus execution must not count toward stall")
endif()
run_case(timeout timeout 70 "SUMMARY: libFuzzer: timeout" --new-stall=1 --cov-stall=1 -timeout=1)
file(GLOB timeout_artifacts "${LAST_DIR}/artifacts/timeout-*")
if(NOT timeout_artifacts)
  message(FATAL_ERROR "Timeout artifact missing")
endif()
run_case(crash crash 77 "SUMMARY: libFuzzer: deadly signal" --new-stall=1)
file(GLOB crash_artifacts "${LAST_DIR}/artifacts/crash-*")
if(NOT crash_artifacts)
  message(FATAL_ERROR "Crash artifact missing")
endif()
run_case(fork flat 1 "unsupported" --new-stall=1 -fork=1)
set(index 0)
foreach(flag IN ITEMS -new_stall=-1 -cov_stall=abc -new_stall=1.5 -cov_stall= -new_stall=2147483648
                     --new-stall=-1 --cov-stall=abc --new-stall=1.5 --cov-stall= --new-stall=99999999999999999999)
  math(EXPR index "${index}+1")
  run_case(invalid_${index} flat 1 "requires nonnegative int32" "${flag}" -runs=2)
endforeach()
# No corpus argument: the alias is literally the last argument.
execute_process(COMMAND "${FIXTURE}" --new-stall RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result EQUAL 1 OR NOT err MATCHES "requires nonnegative int32")
  message(FATAL_ERROR "Missing split alias value not rejected")
endif()
run_case(invalid_path_value flat 1 "requires nonnegative int32" --cov-stall corpus -runs=2)
# The separator must make an alias-looking existing filename an INPUT, not a flag.
set(separator "${WORK}/separator")
file(MAKE_DIRECTORY "${separator}")
file(WRITE "${separator}/--new-stall=abc" "input")
execute_process(COMMAND "${FIXTURE}" -runs=1 -- --new-stall=abc
  WORKING_DIRECTORY "${separator}" RESULT_VARIABLE result ERROR_VARIABLE err TIMEOUT 5)
file(WRITE "${separator}/output.log" "${err}")
if(NOT result EQUAL 0 OR NOT err MATCHES "Running: --new-stall=abc")
  message(FATAL_ERROR "-- separator did not preserve literal path: ${err}")
endif()
message(STATUS "PASS native aliases, semantics, artifacts and separator regression matrix")
